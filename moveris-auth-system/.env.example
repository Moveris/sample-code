# ============================================================================
# Moveris V2 SDK Configuration
# ============================================================================
# This file contains all the environment variables needed for the V2 SDK.
# Copy this file to .env and update the values.

# Required: Your Moveris API Key (get from developers.moveris.com)
VITE_MOVERIS_API_KEY=mv_your_api_key_here

# Optional: API Base URL (leave blank for production)
# Use for staging/development environments
# VITE_MOVERIS_BASE_URL=https://staging.api.moveris.com

# Model Configuration: '10', '50', or '250' frames
# - '10' = Fast check (10 frames, ~1 second capture)
# - '50' = Balanced (50 frames, ~5 seconds capture, 93.8% accuracy)
# - '250' = High accuracy (250 frames, ~25 seconds capture)
VITE_MOVERIS_MODEL=10

# Enable debug mode for development (true/false)
VITE_MOVERIS_DEBUG=false

# Demo Authentication Credentials (for development only)
# WARNING: Never use these in production! Use backend authentication instead.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=Admin@123

# ============================================================================
# Legacy V1 WebSocket Configuration (DEPRECATED)
# ============================================================================
# The V2 SDK uses REST API, not WebSocket. These are kept for migration reference.
# VITE_MOVERIS_WS_URI=wss://developers.moveris.com/ws/live/v1/
# VITE_MOVERIS_SECRET_KEY=your_moveris_secret_key_here
# VITE_FRAME_RATE=10
# VITE_IMAGE_QUALITY=0.7
# VITE_REQUIRED_FRAMES=500
